{
  "id": "example-haven",
  "name": "Haven example system",
  "shortName": "Haven",
  "version": "1.0",
  "description": "A synthetic teaching pack with one planet and one moon. Its costs are invented and must not be used for flight planning.",
  "dataNotice": "Teaching example",
  "transferHubBodyId": "example:haven",
  "sources": [
    {
      "id": "example-guide",
      "title": "Custom pack guide: invented example values",
      "url": "https://github.com/AntonioToni/ksp-deltav/blob/main/docs/CUSTOM_PACKS.md"
    }
  ],
  "assumptions": [
    "All costs are invented teaching values, not measured or sourced KSP or mod budgets.",
    "Directed costs deliberately differ between ascent and descent, and between outbound and return transfers.",
    "No atmospheric assistance, timing constraints, plane changes, or vehicle performance are modeled."
  ],
  "bodies": [
    {
      "id": "example:ember",
      "name": "Ember",
      "parentId": null,
      "kind": "star",
      "hasSurface": false,
      "hasAtmosphere": false,
      "color": "#e7bd7b"
    },
    {
      "id": "example:haven",
      "name": "Haven",
