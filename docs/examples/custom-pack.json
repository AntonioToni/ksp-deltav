    { "id": "example:pebble-to-haven", "from": "example:pebble:encounter", "to": "example:haven:orbit", "deltaV": 95, "kind": "transfer", "label": "Pebble to Haven transfer", "sourceId": "example-guide", "assumptions": ["Invented teaching value."] },
    { "id": "example:pebble-escape", "from": "example:pebble:orbit", "to": "example:pebble:encounter", "deltaV": 20, "kind": "escape", "label": "Pebble escape", "sourceId": "example-guide", "assumptions": ["Invented teaching value."] },
