    { "id": "example:pebble-descent", "from": "example:pebble:orbit", "to": "example:pebble:surface", "deltaV": 60, "kind": "descent", "label": "Pebble powered landing", "sourceId": "example-guide", "assumptions": ["Invented teaching value."] }
