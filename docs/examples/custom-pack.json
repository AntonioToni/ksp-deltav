      "kind": "planet",
      "hasSurface": true,
      "hasAtmosphere": false,
      "color": "#73c8fa"
    },
    {
      "id": "example:pebble",
      "name": "Pebble",
      "parentId": "example:haven",
      "kind": "moon",
      "hasSurface": true,
      "hasAtmosphere": false,
      "color": "#92d5c6"
    }
  ],
  "nodes": [
