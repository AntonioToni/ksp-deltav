    { "id": "example:pebble:surface", "bodyId": "example:pebble", "kind": "surface", "label": "Pebble surface" },
    { "id": "example:pebble:orbit", "bodyId": "example:pebble", "kind": "orbit", "label": "Pebble low orbit" },
